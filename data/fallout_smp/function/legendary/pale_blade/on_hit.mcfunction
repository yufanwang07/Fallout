#> fallout_smp:legendary/pale_blade/on_hit

tellraw @a[tag=convention.debug] {"text":"[Pale Blade] on_hit","color":"white"}
advancement revoke @s only fallout_smp:legendary/pale_blade_hit

tag @e[tag=dep_pale_real_hit] remove dep_pale_real_hit
execute if entity @e[tag=dep_pale_fallback_target,limit=1] as @e[tag=dep_pale_fallback_target,limit=1] run tag @s add dep_pale_real_hit
execute unless entity @e[tag=dep_pale_real_hit,limit=1] at @s as @e[type=!minecraft:player,type=!minecraft:item,type=!minecraft:experience_orb,type=!minecraft:marker,type=!minecraft:interaction,distance=..4.5,sort=nearest,limit=1,nbt={HurtTime:10s}] run tag @s add dep_pale_real_hit
execute if entity @e[tag=dep_pale_real_hit,limit=1] run tellraw @a[tag=convention.debug] {"text":"[Pale Blade] on_hit_target_ok","color":"gray"}
execute unless entity @e[tag=dep_pale_real_hit,limit=1] run tellraw @a[tag=convention.debug] {"text":"[Pale Blade] on_hit_target_fail","color":"red"}
execute if entity @e[tag=dep_pale_real_hit,limit=1] run scoreboard players set @e[tag=dep_pale_real_hit,limit=1] dep.pale_seen 1
execute if entity @e[tag=dep_pale_real_hit,limit=1] if items entity @s weapon.mainhand minecraft:netherite_sword[custom_data~{fallout_smp:{legendary_weapon:"pale_blade"}}] run function fallout_smp:legendary/pale_blade/prepare_sweep_damage
execute if entity @e[tag=dep_pale_real_hit,limit=1,nbt=!{Health:0.0f}] if items entity @s weapon.mainhand minecraft:netherite_sword[custom_data~{fallout_smp:{legendary_weapon:"pale_blade"}}] if score @s dep.sweep_lvl matches 1 run damage @e[tag=dep_pale_real_hit,limit=1] 0.5 minecraft:player_attack by @s
execute if entity @e[tag=dep_pale_real_hit,limit=1,nbt=!{Health:0.0f}] if items entity @s weapon.mainhand minecraft:netherite_sword[custom_data~{fallout_smp:{legendary_weapon:"pale_blade"}}] if score @s dep.sweep_lvl matches 2 run damage @e[tag=dep_pale_real_hit,limit=1] 1 minecraft:player_attack by @s
execute if entity @e[tag=dep_pale_real_hit,limit=1,nbt=!{Health:0.0f}] if items entity @s weapon.mainhand minecraft:netherite_sword[custom_data~{fallout_smp:{legendary_weapon:"pale_blade"}}] if score @s dep.sweep_lvl matches 3.. run damage @e[tag=dep_pale_real_hit,limit=1] 1.5 minecraft:player_attack by @s
execute if entity @e[tag=dep_pale_real_hit,limit=1] if items entity @s weapon.mainhand minecraft:netherite_sword[custom_data~{fallout_smp:{legendary_weapon:"pale_blade"}}] as @e[tag=dep_pale_real_hit,limit=1] run function fallout_smp:legendary/pale_blade/apply_short_glow
execute if entity @e[tag=dep_pale_real_hit,limit=1] if items entity @s weapon.mainhand minecraft:netherite_sword[custom_data~{fallout_smp:{legendary_weapon:"pale_blade"}}] as @e[tag=dep_pale_real_hit,limit=1] at @s positioned ~ ~0.05 ~ run particle minecraft:flash ~ ~ ~ 0 0 0 0 1 force
execute unless entity @s[tag=dep_pale_sweeping] if entity @e[tag=dep_pale_real_hit,limit=1] if items entity @s weapon.mainhand minecraft:netherite_sword[custom_data~{fallout_smp:{legendary_weapon:"pale_blade"}}] at @e[tag=dep_pale_real_hit,limit=1] run playsound minecraft:block.amethyst_cluster.break master @a[distance=..24] ~ ~ ~ 2.5 0.9
execute unless entity @s[tag=dep_pale_sweeping] if entity @e[tag=dep_pale_real_hit,limit=1] if items entity @s weapon.mainhand minecraft:netherite_sword[custom_data~{fallout_smp:{legendary_weapon:"pale_blade"}}] if score @s dep.pale_cd matches 8.. if predicate fallout_smp:legendary/pale_blade_crit as @e[tag=dep_pale_real_hit,limit=1] at @s positioned ~ ~1.50 ~ run function fallout_smp:legendary/pale_blade/render_sweep_hit_crit
execute unless entity @s[tag=dep_pale_sweeping] if entity @e[tag=dep_pale_real_hit,limit=1] if items entity @s weapon.mainhand minecraft:netherite_sword[custom_data~{fallout_smp:{legendary_weapon:"pale_blade"}}] if score @s dep.pale_cd matches 8.. unless predicate fallout_smp:legendary/pale_blade_crit as @e[tag=dep_pale_real_hit,limit=1] at @s positioned ~ ~1.50 ~ run function fallout_smp:legendary/pale_blade/render_sweep_hit

execute unless entity @s[tag=dep_pale_sweeping] if entity @e[tag=dep_pale_real_hit,limit=1] if items entity @s weapon.mainhand minecraft:netherite_sword[custom_data~{fallout_smp:{legendary_weapon:"pale_blade"}}] unless score @s dep.pale_pattern matches 0..3 run scoreboard players set @s dep.pale_pattern 0
execute unless entity @s[tag=dep_pale_sweeping] if entity @e[tag=dep_pale_real_hit,limit=1] if items entity @s weapon.mainhand minecraft:netherite_sword[custom_data~{fallout_smp:{legendary_weapon:"pale_blade"}}] if score @s dep.pale_chain matches 51.. run scoreboard players set @s dep.pale_pattern 0
execute unless entity @s[tag=dep_pale_sweeping] if entity @e[tag=dep_pale_real_hit,limit=1] if items entity @s weapon.mainhand minecraft:netherite_sword[custom_data~{fallout_smp:{legendary_weapon:"pale_blade"}}] if score @s dep.pale_cd matches 8.. if predicate fallout_smp:legendary/pale_blade_crit run function fallout_smp:legendary/pale_blade/try_crit_slash
execute unless entity @s[tag=dep_pale_sweeping] if entity @e[tag=dep_pale_real_hit,limit=1] if items entity @s weapon.mainhand minecraft:netherite_sword[custom_data~{fallout_smp:{legendary_weapon:"pale_blade"}}] if score @s dep.pale_cd matches 8.. unless predicate fallout_smp:legendary/pale_blade_crit run function fallout_smp:legendary/pale_blade/try_slash
execute unless entity @s[tag=dep_pale_sweeping] if entity @e[tag=dep_pale_real_hit,limit=1] if items entity @s weapon.mainhand minecraft:netherite_sword[custom_data~{fallout_smp:{legendary_weapon:"pale_blade"}}] if score @s dep.pale_cd matches 8.. run scoreboard players add @s dep.pale_pattern 1
execute unless entity @s[tag=dep_pale_sweeping] if entity @e[tag=dep_pale_real_hit,limit=1] if items entity @s weapon.mainhand minecraft:netherite_sword[custom_data~{fallout_smp:{legendary_weapon:"pale_blade"}}] if score @s dep.pale_pattern matches 4.. run scoreboard players set @s dep.pale_pattern 0
execute unless entity @s[tag=dep_pale_sweeping] if entity @e[tag=dep_pale_real_hit,limit=1] if items entity @s weapon.mainhand minecraft:netherite_sword[custom_data~{fallout_smp:{legendary_weapon:"pale_blade"}}] if score @s dep.pale_cd matches 8.. run scoreboard players set @s dep.pale_chain 0
execute unless entity @s[tag=dep_pale_sweeping] if entity @e[tag=dep_pale_real_hit,limit=1] if items entity @s weapon.mainhand minecraft:netherite_sword[custom_data~{fallout_smp:{legendary_weapon:"pale_blade"}}] run scoreboard players set @s dep.pale_cd 0

tag @e[tag=dep_pale_real_hit] remove dep_pale_real_hit
